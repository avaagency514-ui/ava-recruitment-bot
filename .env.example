# ava-recruitment-bot — Variables d'environnement Railway

# Identifiants Telegram API (my.telegram.org)
TELEGRAM_API_ID=36121361
TELEGRAM_API_HASH=29263ae8f125a5dfb91491b63264d0e2

# Fichier de session (recruiter.session est inclus dans le projet)
TELEGRAM_SESSION_FILE=recruiter

# Optionnel : StringSession Telethon (si vous préférez une variable plutôt qu'un fichier)
# TELEGRAM_STRING_SESSION=

# Groupes Telegram cibles (séparés par une virgule)
TARGET_GROUPS=@ofmva_fr, @jobonlinevas, @ofmanagementgroupe

# Intervalle de publication en secondes (3600 = 1 heure)
POST_INTERVAL=3600

# Nombre d'annonces IA générées en rotation (défaut : 5)
NB_ANNONCES=5

# Clé API Google Gemini (gratuit sur Google AI Studio)
GEMINI_API_KEY=

# Clé API Groq (fallback de secours)
GROQ_API_KEY=
