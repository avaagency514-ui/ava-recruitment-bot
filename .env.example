# ava-recruitment-bot — Variables d'environnement Railway

# Token du bot Telegram de publication
TELEGRAM_TOKEN=VOTRE_TOKEN_TELEGRAM_ICI

# IDs des groupes Telegram cibles (séparés par virgule)
# Ex: -1001234567890,-1009876543210
TARGET_GROUPS=-1001234567890

# Intervalle entre les publications en secondes (3600 = 1h)
POST_INTERVAL=3600

# Nombre d'annonces à générer au démarrage (3 à 5 recommandé)
NB_ANNONCES=5

# Clé API Gemini (Google AI Studio — gratuit)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI

# Clé API Groq (fallback si Gemini échoue — gratuit)
# https://console.groq.com/keys
GROQ_API_KEY=VOTRE_CLE_GROQ_ICI
