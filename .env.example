# ava-recruitment-bot — Variables d'environnement Railway

# Identifiants Telegram API (my.telegram.org)
TELEGRAM_API_ID=36121361
TELEGRAM_API_HASH=29263ae8f125a5dfb91491b63264d0e2
TELEGRAM_PHONE=+261381789477

# Fichier de session (recruiter.session est inclus dans le projet)
TELEGRAM_SESSION_FILE=recruiter

# ⏱️ Intervalle fixe : 20 minutes (1200 secondes)
POST_INTERVAL=1200

# Nombre d'annonces IA générées en rotation (défaut : 5)
NB_ANNONCES=5

# Clé API Google Gemini (ou Google AI Studio)
GEMINI_API_KEY=

# Clé API FreeLLM
FREELLM_API_KEY=
FREELLM_API_URL=https://api.freellm.io/v1

# Optionnel : si vide, charge automatiquement les 137 groupes de recrutement de groupes_scanned.json
# TARGET_GROUPS=
